#include <stdio.h>

int digitalRoot(int n)
{
    if (n < 10)
        return n;

    int sum = 0;

    while (n > 0)
    {
        sum = sum + n % 10;
        n = n / 10;
    }

    return digitalRoot(sum);
}

long long power_linear(long long base, int exp)
{
    if (exp == 0)
        return 1;

    return base * power_linear(base, exp - 1);
}

long long power_fast(long long base, int exp)
{
    if (exp == 0)
        return 1;

    long long half = power_fast(base, exp / 2);

    if (exp % 2 == 0)
        return half * half;
    else
        return base * half * half;
}

int main()
{
    printf("Digital Root: %d\n", digitalRoot(9875));
    printf("Linear Power: %lld\n", power_linear(2, 5));
    printf("Fast Power: %lld\n", power_fast(2, 5));

    return 0;
}
